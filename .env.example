# ─────────────────────────────────────────────────────────────
# QuotaBar 설정 파일
#
# 위치: ~/.config/quotabar/.env  (메뉴 → "설정 파일 열기"로 자동 생성)
# 다른 위치를 쓰려면 QUOTABAR_ENV_FILE 환경 변수로 경로를 지정하세요.
# 값을 바꾼 뒤 메뉴 → "설정 다시 불러오기"를 누르면 적용됩니다.
#
# 구독(정액제) 사용량은 각 CLI 의 로그인 정보를 자동으로 사용하므로
# 아무것도 설정하지 않아도 동작합니다.
# ─────────────────────────────────────────────────────────────

# ── 일반 ─────────────────────────────────────────────────────
# 자동 갱신 주기(분). 최소 1분.
QUOTABAR_REFRESH_MINUTES=10

# ── 구독 사용량: 서비스별 켜기/끄기 ─────────────────────────
QUOTABAR_CLAUDE_ENABLED=true
QUOTABAR_CODEX_ENABLED=true
QUOTABAR_GEMINI_ENABLED=true
QUOTABAR_GROK_ENABLED=true

# Gemini 데이터 소스
#   auto        : agy(Antigravity CLI)가 있으면 Antigravity, 없으면 Gemini CLI
#   antigravity : 개인 Google AI Pro/Ultra 구독 (2026-06 이후 Gemini CLI 개인 로그인 종료)
#   gemini-cli  : Workspace / 교육 / Code Assist Standard·Enterprise 계정
QUOTABAR_GEMINI_SOURCE=auto

# Gemini 타일에 표시할 구독 이름 (예: AI Pro, AI Ultra).
# Antigravity CLI 는 구독 등급을 알려주지 않아 직접 적어야 표시됩니다. 비우면 표시하지 않습니다.
# QUOTABAR_GEMINI_PLAN=AI Pro

# Antigravity 안에서 쓰는 Claude·GPT 모델 한도도 Gemini 타일에 함께 표시 (기본 false: Gemini 모델 한도만)
# QUOTABAR_GEMINI_THIRD_PARTY=true

# ── CLI 실행 파일 경로 (자동 탐색이 실패할 때만) ─────────────
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
# CODEX_CLI_PATH=/opt/homebrew/bin/codex
# ANTIGRAVITY_CLI_PATH=/opt/homebrew/bin/agy
# GEMINI_CLI_PATH=/opt/homebrew/bin/gemini
# GROK_CLI_PATH=/opt/homebrew/bin/grok

# ── CLI 설정 디렉터리 (기본 위치가 아닐 때만) ───────────────
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# GROK_HOME=~/.grok

# ── Gemini CLI 토큰 갱신용 OAuth 클라이언트 (gemini-cli 소스 전용) ─
# 비워 두면 설치된 Gemini CLI 에서 자동으로 찾습니다.
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=

# ── API(종량제) 사용량 — 추후 지원 예정 ─────────────────────
# 키를 넣어 두면 API 사용량 카드가 추가될 수 있도록 설정 구조만 준비되어 있습니다.
# (현재 버전은 구독 사용량만 표시합니다)
# 이 값들은 CLI 자식 프로세스에 전달되지 않습니다.
#
# Anthropic Admin API 키 (sk-ant-admin...) — console.anthropic.com → Settings → Admin keys
# ANTHROPIC_ADMIN_API_KEY=
#
# OpenAI Admin API 키 — platform.openai.com → Settings → Organization → Admin keys
# OPENAI_ADMIN_API_KEY=
#
# xAI Management API 키 + 팀 ID — console.x.ai → Settings → Management Keys (Billing 읽기 전용 권장)
# XAI_MANAGEMENT_API_KEY=
# XAI_TEAM_ID=
